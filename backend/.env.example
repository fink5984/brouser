# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Secrets -- generate each with: openssl rand -base64 32 ----------------
# Bearer token the app sends to GET /device/config. There is one device, so
# there is one token: put the same value into the Android app's build config.
DEVICE_TOKEN=replace-with-a-random-secret-at-least-24-chars
# Shared secret between this backend and the Squid auth helper only.
INTERNAL_API_SECRET=replace-with-a-different-random-secret

# --- Proxy credentials (must match what you configure in the Android app) --
PROXY_USERNAME=device
PROXY_PASSWORD=replace-with-a-strong-random-password

# --- Proxy connection info handed to the app --------------------------------
PROXY_HOST=127.0.0.1
PROXY_PORT=3129
# "https" (recommended) means the app opens a TLS connection to the proxy
# itself, protecting credentials in transit -- matches Squid's https_port.
# Use "http" + port 3128 only for local development.
PROXY_SCHEME=https

# --- Browser defaults, editable without rebuilding the APK ------------------
HOMEPAGE=https://www.google.com
SEARCH_ENGINE=google
MAX_TABS=10
DOWNLOADS_ENABLED=true
LATEST_VERSION=1.0.0
MINIMUM_VERSION=1.0.0

CORS_ORIGIN=*
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
LOG_LEVEL=info

# Copy this file to .env at the project root and fill in real values before
# running `docker compose --env-file .env -f docker/docker-compose.yml up -d`.
# Never commit the resulting .env file.
#
# This is a single-device deployment: there is no database and no admin
# panel. All configuration lives here.

# --- Domain (used by Caddy for automatic HTTPS + routing to the backend) --
# Only needed for the self-hosted Docker Compose path. Not needed on Railway
# (which provides HTTPS routing itself) -- see docs/deployment-railway.md.
API_DOMAIN=api.example.com
# Public hostname devices will connect to for the TLS-secured proxy port.
# Also used as the CN of the proxy's self-signed development certificate.
PROXY_PUBLIC_HOST=proxy.example.com
ACME_EMAIL=admin@example.com

# --- Secrets -- generate each with: openssl rand -base64 32 ----------------
# Bearer token the app sends to GET /device/config. There is one device, so
# there is one token: put the same value into the Android app's build config
# (see android/local.properties.example).
DEVICE_TOKEN=
# Shared secret between the backend and the Squid auth helper only. Never
# leaves the Docker-internal network.
INTERNAL_API_SECRET=

# --- Proxy credentials ------------------------------------------------------
# Must match what you configure in the Android app's build config.
PROXY_USERNAME=device
PROXY_PASSWORD=

# --- Proxy connection info handed to the app --------------------------------
PROXY_HOST=proxy.example.com
PROXY_PORT=3129
PROXY_SCHEME=https

# --- Browser defaults, editable here without rebuilding the APK ------------
HOMEPAGE=https://www.google.com
SEARCH_ENGINE=google
MAX_TABS=10
DOWNLOADS_ENABLED=true
LATEST_VERSION=1.0.0
MINIMUM_VERSION=1.0.0

CORS_ORIGIN=*
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
LOG_LEVEL=info
